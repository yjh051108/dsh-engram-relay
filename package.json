{
  "name": "@dsh-external/dsh-engram-relay",
  "version": "0.1.3",
  "description": "澶?engram 灏?KV锛氬缃?engram 杞帴灞傦紙璺ㄤ細璇濆垎灞傝蹇嗭細global/project/session锛孉I 鑷富鍐崇瓥褰掑睘 + 鍥犳灉閾炬帴绱㈠紩 + 娓愯繘鎶湶 + 涓诲姩鍞ら啋锛夛紝涓?DSH 瀹炵幇瓒呴暱涓婁笅鏂囪蹇嗙█鐤忚矾鐢憋紝涓庡畼鏂?compact 鍏卞瓨锛堝畼鏂硅吘 KV锛宔ngram 淇濈粏鑺傦級",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "model"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-external/dsh-engram-relay.git"
  },
  "homepage": "https://github.com/dsh-external/dsh-engram-relay#readme",
  "bugs": {
    "url": "https://github.com/dsh-external/dsh-engram-relay/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "engram",
    "rag",
    "causal-graph",
    "semantic-search"
  ],
  "engines": {
    "dsh": ">=0.0.1-rc"
  },
  "dependencies": {
    "@huggingface/transformers": "3.6.3",
    "onnxruntime-node": "1.20.1"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "engram_recall",
        "engram_store",
        "engram_propose",
        "engram_confirm",
        "engram_reject",
        "engram_open",
        "engram_search",
        "engram_link",
        "engram_update",
        "engram_remove",
        "engram_promote",
        "engram_weave",
        "engram_status"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "build:all": "bash scripts/build.sh && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node --test \"tests/*.test.mjs\" \"tests/*.test.js\"",
    "test:python": "python python/tests/test_engram_module.py && python python/tests/test_hash.py",
    "sim:1m": "node tests/simulate-1m.mjs",
    "sim:causal": "node tests/simulate-causal.mjs"
  }
}

