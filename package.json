{
  "name": "@dsh-external/dsh-engram-relay",
  "version": "0.1.0",
  "description": "大 engram 小 KV：魔改 Qwen3-0.6B（Engram 条件记忆 × DSA 稀疏路由），为 DSH 实现超长上下文记忆稀疏路由——外置 engram 转接层，与官方 compact 共存（官方腾 KV，engram 保细节）",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "license": "BSD-3-Clause",
  "engines": { "dsh": ">=0.0.1" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "contributes": {
      "tools": ["engram_recall", "engram_store", "engram_status"],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.mjs\" \"tests/*.test.js\"",
    "test:python": "python python/tests/test_engram_module.py && python python/tests/test_hash.py",
    "sim:1m": "node tests/simulate-1m.mjs",
    "sim:causal": "node tests/simulate-causal.mjs"
  }
}
